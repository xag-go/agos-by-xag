# Environment for the AGOS core and web (dev: apps/web/.env.local and
# scripts/dev-up.sh; server: deploy/install-server.sh). Never commit a real one.
#
# Every variable is optional unless it says otherwise; the value shown (or the
# "Default:" note) is what AGOS uses when the line is missing.
#
# Your own keys (model providers, Google, Composio, Telegram bots) are NOT set
# here: each user adds them in the app (Settings → Models, a workspace's
# Connections), and AGOS writes them into Hermes. AGOS ships with no keys.

# ---- Data ----------------------------------------------------------------------
# Where AGOS keeps everything (database, workspaces, files, Hermes roots). Absolute path. Default: ~/agos-data.
AGOS_DATA_DIR=
# Where backups go; must be outside the data folder. Default: agos-backups next to the data folder.
AGOS_BACKUP_DIR=
# Token file the core writes on start and the web reads. Default: <data folder>/system/internal.token.
AGOS_INTERNAL_TOKEN_FILE=

# ---- Time ----------------------------------------------------------------------
# The process clock. Leave unset to use this machine's timezone (UTC when it has none).
# The agents' timezone is set in the app: Settings → General → Your timezone.
# TZ=

# ---- Core (Python API, services/core) ---------------------------------------------
# Agent engine (ADR 0010). "hermes" = each workspace gets its own Hermes Agent
# root and Docker sandbox; needs `hermes` and Docker on this machine.
# Empty or "none" = no engine (the app works on its own data only: demo, tests).
AGOS_ENGINE=
# Where the web reaches the core.
AGOS_CORE_URL=http://127.0.0.1:8766
# Address the core listens on. Default: 127.0.0.1 (the Docker image sets 0.0.0.0 for its private network).
AGOS_CORE_HOST=
# Port of the webhook relay (python -m agos_core.hook_relay), the only port a public tunnel may point at.
AGOS_HOOKS_PORT=8767
# First port tried for a workspace's Hermes webhook listener.
AGOS_WEBHOOK_FIRST_PORT=8650
# Reserved: a link to an external documents site (read, not used by the current UI).
AGOS_DOCUMENTS_URL=

# ---- Hermes (the engine) ------------------------------------------------------------
# The hermes command. Default: the one on PATH.
AGOS_HERMES_BIN=
# The home Hermes runs as (its ~/.hermes lives there). Default: $HOME.
AGOS_HERMES_USER_HOME=
# Where each workspace's Hermes root lives; must be outside ~/.hermes. Default: <data folder>/hermes.
AGOS_HERMES_ROOTS=
# Hermes's own runtime folder. Default: <Hermes home>/tools.
AGOS_HERMES_RUNTIME_DIR=
# Hermes's managed settings folder (one value for every workspace). Default: hermes-managed next to the roots.
AGOS_HERMES_MANAGED_DIR=
# The Hermes git checkout `hermes update` updates. Default: ~/.hermes/hermes-agent.
AGOS_HERMES_SRC=
# How a workspace's gateway runs: "systemd" (Hermes's user service) or "spawn" (tests only).
AGOS_HERMES_GATEWAY_SUPERVISOR=systemd
# Prefix of the Hermes profile names AGOS makes (lowercase letters, digits, '-').
AGOS_PROFILE_PREFIX=agos-

# ---- Sandboxes (Docker) ---------------------------------------------------------------
# The docker command. Default: the one on PATH.
AGOS_DOCKER_BIN=
# Image for the workspaces' sandboxes (scripts/build-sandbox.sh builds it). Default: agos-sandbox:1.
AGOS_SANDBOX_IMAGE=
# Tag scripts/build-sandbox.sh builds.
AGOS_SANDBOX_TAG=agos-sandbox:1
# Port of the egress proxy, the sandboxes' only way out.
AGOS_EGRESS_PORT=8888
# Ports the egress proxy lets sandboxes reach (comma separated).
AGOS_EGRESS_PORTS=80,443

# ---- Web access (apps/web) ----------------------------------------------------------------
# AGOS has no login. The web and the core listen on 127.0.0.1 only, so AGOS opens
# on this machine with nothing to type (an SSH tunnel counts as this machine:
# ssh -L 3000:localhost:3000 you@this-machine).
#
# From another device, over Tailscale only: run `tailscale serve 3000` here, then
# set your Tailscale host name and your Tailscale login below (comma separated).
# Any other request is refused.
AGOS_ALLOWED_HOSTS=
AGOS_TAILSCALE_USERS=

# ---- Scripts and development -------------------------------------------------------------
# Backup password for deploy/rehearse-in-container.sh and scripts/restore_and_verify.py (asked when missing).
AGOS_BACKUP_PASSWORD=
# Logs folder of scripts/dev-up.sh. Default: ~/Library/Logs/agos-dev.
AGOS_DEV_LOGS=
# deploy/install-server.sh: 1 = print what it would do, change nothing.
AGOS_INSTALL_DRY_RUN=0

# ---- Installer (install.sh, install.ps1, deploy/install-server.sh; docs/INSTALL.md) ----
# Where AGOS is downloaded from, and which branch (the agos update follows it).
AGOS_REPO_URL=https://github.com/xag-go/agos-by-xag.git
AGOS_REF=main
# 1 = no questions: every default plus the variables below.
AGOS_YES=0
# new = a user just for AGOS (AGOS_USER, default agos); current = the user running the installer.
AGOS_USER_MODE=new
AGOS_USER=
# The model provider set up at install (skip = later in Settings -> Models), and its
# key. Put the key in the environment or a file (AGOS_PROVIDER_KEY_FILE), never in a flag.
AGOS_PROVIDER=skip
AGOS_PROVIDER_KEY=
AGOS_PROVIDER_KEY_FILE=
# Voice notes: off, gemini, openai or local.
AGOS_VOICE=off
# yes = install Tailscale for other devices (then Settings -> Access).
AGOS_REMOTE=no
# 1 = install even with less than 20 GB free.
AGOS_SKIP_DISK_CHECK=0
# macOS: the Lima VM's name, CPUs, memory (GB) and disk (GB).
AGOS_VM_NAME=agos
AGOS_VM_CPUS=4
AGOS_VM_MEMORY=8
AGOS_VM_DISK=60
# Windows: the WSL distribution AGOS runs in.
AGOS_WSL_DISTRO=Ubuntu-24.04
# Set by the installer in agos-core's service: the AGOS release folder (Settings -> Update AGOS).
AGOS_APP_DIR=
# The installer's settings file the core reads for Update AGOS.
AGOS_CONF=/etc/agos/agos.conf
# The agos command the core starts for Update AGOS. Default: the one on PATH.
AGOS_BIN=
# 1 = a blocking call on the core's event loop fails instead of being logged (tests).
AGOS_STRICT_LOOP=0

# ---- Set in the app, not here ----------------------------------------------------------
# Timezone: Settings → General (Hermes's own `timezone`). Not set = this server's timezone.
# Voice notes: Settings → General → Voice notes (Hermes's `stt.*`). Off until you pick a provider.
# Models and provider keys: Settings → Models (Hermes keeps them).
