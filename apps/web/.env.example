# Where the Python core listens, and the token file it creates on start.
# Defaults: http://127.0.0.1:8766 and <AGOS_DATA_DIR or ~/agos-data>/system/internal.token.
AGOS_CORE_URL=http://127.0.0.1:8766
AGOS_INTERNAL_TOKEN_FILE=
# The data folder (only used to find the token file when it isn't set above).
AGOS_DATA_DIR=
# Access (see the root .env.example).
AGOS_ALLOWED_HOSTS=
AGOS_TAILSCALE_USERS=
