; Layer rules for agos_core (import-linter: `uv run lint-imports` in services/core).
; Direct AND indirect import chains, module-level and lazy (inside functions).
; Today's breaks are listed under ignore_imports; an ignore that stops matching is an
; error, so the lists only shrink. GENERATED by scripts/importlinter_ignores.py from the
; rules in scripts/layer_ratchet.py, which also counts every statement (a second lazy
; import along an already ignored pair fails there).

[importlinter]
root_package = agos_core
include_external_packages = False
exclude_type_checking_imports = False

[importlinter:contract:layers]
name = api -> actions -> engine|hermes_gateway|ops|uow|saga|events|outbox|jobs -> db|storage|security -> domain, never upward
type = layers
layers =
    agos_core.api
    agos_core.actions
    agos_core.engine : agos_core.hermes_gateway : agos_core.ops : agos_core.uow : agos_core.saga : agos_core.events : agos_core.outbox : agos_core.jobs
    agos_core.db : agos_core.storage : agos_core.security
    agos_core.domain

[importlinter:contract:api-only-via-actions]
name = api reaches engine/hermes_gateway/db/storage/security only through actions
type = forbidden
source_modules = agos_core.api
forbidden_modules =
    agos_core.engine
    agos_core.hermes_gateway
    agos_core.db
    agos_core.storage
    agos_core.security
allow_indirect_imports = True
ignore_imports =
    agos_core.api.** -> agos_core.db.records

[importlinter:contract:core-not-plugin]
name = core code never imports hermes_plugin (it runs inside Hermes)
type = forbidden
source_modules =
    agos_core.api
    agos_core.actions
    agos_core.engine
    agos_core.hermes_gateway
    agos_core.db
    agos_core.storage
    agos_core.security
    agos_core.background
    agos_core.shared
    agos_core.domain
    agos_core.context
    agos_core.config
    agos_core.hook_relay
    agos_core.migrate_root
forbidden_modules = agos_core.hermes_plugin

[importlinter:contract:plugin-standalone]
name = hermes_plugin imports no core package (it talks HTTP)
type = forbidden
source_modules = agos_core.hermes_plugin
forbidden_modules =
    agos_core.api
    agos_core.actions
    agos_core.engine
    agos_core.hermes_gateway
    agos_core.db
    agos_core.storage
    agos_core.security
    agos_core.background
    agos_core.shared
    agos_core.domain
    agos_core.context
    agos_core.config
    agos_core.hook_relay
    agos_core.migrate_root

[importlinter:contract:domain-pure]
name = domain imports nothing else from agos_core
type = forbidden
source_modules = agos_core.domain
forbidden_modules =
    agos_core.api
    agos_core.actions
    agos_core.engine
    agos_core.hermes_gateway
    agos_core.db
    agos_core.storage
    agos_core.security
    agos_core.background
    agos_core.shared
    agos_core.hermes_plugin
    agos_core.context
    agos_core.config
    agos_core.hook_relay
    agos_core.migrate_root

[importlinter:contract:shared-pure]
name = shared imports nothing else from agos_core (it is copied into the plugin)
type = forbidden
source_modules = agos_core.shared
forbidden_modules =
    agos_core.api
    agos_core.actions
    agos_core.engine
    agos_core.hermes_gateway
    agos_core.db
    agos_core.storage
    agos_core.security
    agos_core.background
    agos_core.domain
    agos_core.hermes_plugin
    agos_core.context
    agos_core.config
    agos_core.hook_relay
    agos_core.migrate_root
